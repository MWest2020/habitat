# Habitat worker-image: één container met Claude Code headless + uv + git + python3.
# Alleen worker-eigen tools worden gebakken; doel-repo-deps komen runtime.
# Gepinde versies, nooit `latest`. Build-context = repo-root.
FROM node:22.11.0-bookworm-slim

# uv (gepind), meegekopieerd uit de officiële distroless image
COPY --from=ghcr.io/astral-sh/uv:0.11.15 /uv /uvx /bin/

# git + ca-certificates + jq (verdict-parsing) + python3 (audit/rapport-tool)
# + shellcheck: staat in de builder-allowlist en in verify.sh van doelrepo's,
#   die hem alleen "indien aanwezig" aanroept — zonder shellcheck in de image
#   degradeert die controle stil tot een no-op zonder dat het opvalt.
RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates jq python3 shellcheck \
 && rm -rf /var/lib/apt/lists/*

# Claude Code headless (gepinde versie; ≥2.1.220 voor --json-schema/dontAsk/--setting-sources)
# + de OpenSpec-CLI: taken van een change eisen `openspec validate --strict`, en
#   zonder de CLI kan een rol dat niet zelf bewijzen (waargenomen 2026-09-04:
#   een builder-run die verder klaar was, viel hierop terug op FAIL).
#   Pakket is `@fission-ai/openspec` — het kale `openspec` op npm is een lege
#   placeholder (0.0.0). Versie gepind op wat lokaal en in de hub gebruikt wordt,
#   zodat een run-validatie hetzelfde oordeelt als een validatie op een werkstation.
RUN npm install -g @anthropic-ai/claude-code@2.1.220 @fission-ai/openspec@1.3.1 \
 && npm cache clean --force

# Skill-bodies uit skill-forge, gepind op commit (nooit een branch: de image is
# immutable en een skill-update hoort een zichtbare pin-bump te zijn). De rol krijgt
# straks alléén de skills die zijn definitie noemt — alle 47 meeladen zou ~4.000
# tokens per run kosten aan skill-beschrijvingen, terwijl een rol er nul of één heeft.
ARG SKILLS_REF=44ce9a8d2b3e560e4927ed4e803eccccc9e7fe5f
RUN mkdir -p /tmp/sf /opt/habitat \
 && git -C /tmp/sf init -q \
 && git -C /tmp/sf remote add origin https://github.com/MWest2020/skill-forge.git \
 && git -C /tmp/sf fetch -q --depth 1 origin "$SKILLS_REF" \
 && git -C /tmp/sf checkout -q FETCH_HEAD \
 && mv /tmp/sf/skills /opt/habitat/skills \
 && rm -rf /tmp/sf

# Habitat-eigen tooling (audit + HTML-rapport + per-rol enforcement)
COPY report/ /opt/habitat/report/
COPY worker/settings/ /opt/habitat/settings/
COPY worker/schemas/  /opt/habitat/schemas/
COPY worker/hooks/    /opt/habitat/hooks/
COPY worker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh /opt/habitat/hooks/*.sh \
 && useradd -m -u 10001 worker \
 && mkdir -p /work && chown worker:worker /work

USER worker
WORKDIR /work
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
