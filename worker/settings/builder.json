{
  "permissions": {
    "defaultMode": "dontAsk",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Read", "Edit", "Write", "Grep", "Glob",
      "Bash(git add *)", "Bash(git commit *)", "Bash(git rm *)", "Bash(git mv *)",
      "Bash(git status)", "Bash(git status *)",
      "Bash(git diff)", "Bash(git diff *)",
      "Bash(git log)", "Bash(git log *)",
      "Bash(git show *)", "Bash(git checkout *)", "Bash(git branch *)",
      "Bash(uv run *)", "Bash(uv sync *)", "Bash(uv lock *)", "Bash(uvx *)",
      "Bash(npm test *)", "Bash(npm run *)", "Bash(npm ci)", "Bash(npx *)",
      "Bash(go test *)", "Bash(go build *)", "Bash(go vet *)",
      "Bash(make *)", "Bash(pytest *)", "Bash(shellcheck *)",
      "Bash(mkdir *)", "Bash(ls *)", "Bash(chmod *)",
      "Bash(openspec validate *)"
    ],
    "deny": [
      "Bash(git push)", "Bash(git push *)",
      "Bash(cat *)", "Bash(head *)", "Bash(tail *)", "Bash(cp *)", "Bash(mv *)",
      "Bash(dd *)", "Bash(xxd *)", "Bash(od *)", "Bash(base64 *)",
      "Bash(curl *)", "Bash(wget *)", "Bash(ssh *)", "Bash(scp *)", "Bash(nc *)",
      "Bash(kubectl *)", "Bash(docker *)", "Bash(env)", "Bash(printenv *)",
      "WebFetch", "WebSearch",
      "Read(./.env)", "Read(./.env.*)", "Read(**/.env)", "Read(**/.env.*)",
      "Read(**/secrets/**)", "Read(**/*.pem)", "Read(**/id_rsa*)",
      "Read(**/.credentials.json)", "Read(//home/**/.claude/**)",
      "Read(//root/.claude/**)", "Read(//var/run/claude/**)",
      "Read(//proc/**)", "Read(//sys/**)",
      "Edit(**/.credentials.json)", "Write(**/.credentials.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "/opt/habitat/hooks/pretooluse-guard.sh" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "/opt/habitat/hooks/stop-verify.sh" }
        ]
      }
    ]
  }
}
