{
  "permissions": {
    "defaultMode": "dontAsk",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Read", "Grep", "Glob",
      "Bash(git diff)", "Bash(git diff *)",
      "Bash(git log)", "Bash(git log *)",
      "Bash(git status)", "Bash(git status *)",
      "Bash(git show *)",
      "Bash(openspec validate *)"
    ],
    "deny": [
      "Edit", "Write", "NotebookEdit",
      "WebFetch", "WebSearch",
      "Bash(git push)", "Bash(git push *)",
      "Bash(cat *)", "Bash(head *)", "Bash(tail *)", "Bash(env)", "Bash(printenv *)",
      "Bash(curl *)", "Bash(wget *)", "Bash(nc *)", "Bash(base64 *)",
      "Read(./.env)", "Read(**/.env)",
      "Read(**/.env.local)", "Read(**/.env.*.local)",
      "Read(**/.env.development)", "Read(**/.env.dev)",
      "Read(**/.env.production)", "Read(**/.env.prod)",
      "Read(**/.env.staging)", "Read(**/.env.test)",
      "Read(**/.env.secret)", "Read(**/.env.secrets)",
      "Read(**/secrets/**)", "Read(**/*.pem)", "Read(**/id_rsa*)",
      "Read(**/.credentials.json)", "Read(//home/**/.claude/**)",
      "Read(//root/.claude/**)", "Read(//var/run/claude/**)",
      "Read(//proc/**)", "Read(//sys/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "/opt/habitat/hooks/pretooluse-guard.sh" }
        ]
      }
    ]
  }
}
